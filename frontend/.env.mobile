# ── Mobile / APK Build Environment ───────────────────────────────────────────
# PRAHARI AI — Android APK LAN backend configuration
#
# INSTRUCTIONS:
# 1. Find your PC's local IP: run `ipconfig` (Windows) → look for "IPv4 Address"
# 2. Replace 192.168.1.X below with your actual PC IP address
# 3. Ensure your phone and PC are on the same Wi-Fi network
# 4. Start the backend: uvicorn backend.app.main:app --host 0.0.0.0 --port 8000
#
VITE_API_BASE_URL=http://192.168.1.X:8000
