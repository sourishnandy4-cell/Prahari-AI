# Aegis AI — Environment Configuration
# Copy to .env and fill in values.

# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# ── Agentic RAG Tuning ─────────────────────────────────────────────────────────
RETRIEVAL_K=6          # number of chunks retrieved per query
BM25_WEIGHT=0.4        # hybrid search BM25 weight (0=pure vector, 1=pure BM25)
MAX_HOPS=2             # max multi-hop reasoning iterations
REWRITE_QUERY=true     # enable LLM query rewriting before retrieval
SELF_CRITIQUE=true     # enable LLM self-validation of generated answer

# ── Authentication (optional) ──────────────────────────────────────────────────
# Uncomment and set a secret key to require X-API-Key header on all /api/* routes
# API_KEY=your_secret_key_here
